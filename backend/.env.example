APP_NAME="IPS UPC v2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL del frontend (React+Vite) para CORS/Sanctum
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos COMPARTIDA e INTACTA (ipsupc_ips). En el stack de este repo el
# servicio se llama `db` (ver docker-compose.yml). La BD NO se versiona: hay que
# importar el dump en database/dump/ (ver database/dump/README.md).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ipsupc_ips
DB_USERNAME=root
DB_PASSWORD=root

# Auth por COOKIE de sesión (Sanctum SPA) => sin tablas extra (no tocamos la BD)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# localhost => la cookie de sesión se comparte entre :5173 (front) y :8000 (api)
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax

# Dominios que reciben cookie de sesión stateful (Sanctum SPA)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
