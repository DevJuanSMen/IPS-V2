# URL base de la API del backend Laravel (IPS v2).
VITE_API_URL=http://localhost:8000/api

# Base del backend (para GET /sanctum/csrf-cookie). Por defecto se deriva de
# VITE_API_URL quitando el sufijo /api, así que normalmente no hace falta.
# VITE_BACKEND_URL=http://localhost:8000

# Modo mock: "true" => el front funciona SIN backend (login y datos simulados).
# Ponlo en "false" para conectar con el backend real (Sanctum SPA por cookie).
VITE_USE_MOCK=false
